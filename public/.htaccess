RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Remove www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Remove trailing slashes (except root)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Block old WordPress URLs — 410 Gone
RewriteRule ^wp-admin(.*)$ - [G,L]
RewriteRule ^wp-login\.php$ - [G,L]
RewriteRule ^wp-content(.*)$ - [G,L]
RewriteRule ^wp-includes(.*)$ - [G,L]
RewriteRule ^xmlrpc\.php$ - [G,L]
RewriteRule ^wp-json(.*)$ - [G,L]
RewriteRule ^wp-cron\.php$ - [G,L]

# SPA fallback — serve index.html for all routes that don't match a real file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html [L]
